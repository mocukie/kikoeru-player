{
  "name": "kikoeru-player",
  "version": "0.0.0",
  "description": "kikoeru 前端使用的 headless 播放引擎",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mocukie/kikoeru-player.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./background": {
      "types": "./dist/background/index.d.ts",
      "default": "./dist/background/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "NOTICE",
    "LICENSES/"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.build.json --force",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project node",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/audioworklet": "^0.0.100",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
