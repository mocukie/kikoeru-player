# wasm 的版本釘選（ADR-0005）。由 build.sh source，scripts/wasm.ts 也讀取 LIBAVJS_VERSION 與 VARIANT。
# 只能寫 KEY=VALUE，不加引號、不用變數展開。

# libav.js：釘 tag，clone 後核對 commit。FFmpeg 版本由 libav.js 的 Makefile 決定。
LIBAVJS_VERSION=6.10.9.0
LIBAVJS_COMMIT=c80e885c3461f7bb7ea565c9631b34243ae0dbf1

# 上游 tarball 的 sha256：libav.js 的 Makefile 下載時不驗證，所以 build.sh 先下載並核對，再放進 build/。
FFMPEG_VERSION=9.0
FFMPEG_SHA256=7f607a00dd0d28a729d5a4811205812eef01cf6ef6155025febb6f36a9062d52
# emfiberthreads（0BSD）：libav.js 的 base target 一律連結。
EMFT_VERSION=1.3
EMFT_SHA256=0fe933d7742de3b3213608e0fb087a1ae0d060604d5835f7c9cdfcee0fc8cbcb

# 產物檔名為 libav-<LIBAVJS_VERSION>-<VARIANT>.*；fragment 見 fragments.txt。
VARIANT=kikoeru
