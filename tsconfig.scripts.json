{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": ["node"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.scripts.tsbuildinfo"
  },
  "include": ["scripts", "*.config.ts", "*.config.js"]
}
